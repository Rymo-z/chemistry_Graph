# 统一行尾与二进制声明，避免跨平台 CRLF/LF 噪音
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
*.bat  text eol=crlf
*.json text eol=lf
*.jsonl text eol=lf

# 二进制/模型/索引文件一律不按文本处理
*.faiss binary
*.pkl   binary
*.pt    binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.zip   binary
*.gz    binary
*.pdf   binary
*.doc   binary
*.docx  binary
