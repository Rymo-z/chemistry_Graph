# ========== 配置模板：复制为 .env 后按需修改 ==========
#   cp .env.example .env
# 所有路径以项目根目录（BASE_DIR）为基准，请从项目根启动服务（start.bat 已处理）。
# Docker 部署场景见 docs/DEPLOYMENT.md 与 docker-compose.yml 的注释。

# ========== 大模型 LLM（OpenAI 兼容） ==========
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxx                     # 你的密钥，请勿提交到 git
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
# deepseek 等推理模型会把输出 token 烧在 reasoning_content 上，导致抽取任务 content 为空；
# 默认关闭思考以获得确定性的直接输出。
LLM_DISABLE_THINKING=true

# ========== Neo4j ==========
NEO4J_URI=bolt://localhost:7687           # Docker 部署时改为 bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

# ========== Embedding + FAISS ==========
# 本地模型目录。`python scripts/download_models.py` 会把 bge-large-zh-v1.5 拉到 models/ 下；
# 也可填 HuggingFace 模型名（将自动联网下载）。
EMBEDDING_MODEL=models/bge-large-zh-v1.5
FAISS_INDEX_NAME=regulation_index.faiss
FAISS_META_NAME=metadata.json
FAISS_MAP_NAME=id_map.pkl

# ========== CV (YOLOv8) ==========
# `python scripts/download_models.py` 会把 yolov8n.pt 拉到 models/ 下；
# 留空则回退按 YOLO_MODEL_NAME 自动下载。
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_MODEL_NAME=yolov8n.pt

# ========== 服务 ==========
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
API_BASE=http://127.0.0.1:8000           # 前端访问后端地址；Docker 部署时改为 http://api:8000

# ========== 运行模式 ==========
# 示例数据模式：新用户无需完整爬取数据，用仓库内 sample_data/ 直接体验 RAG demo。
# 完整数据模式（false）需先跑数据链路 scripts/rebuild_pipeline.py。
USE_SAMPLE_DATA=false
